@using Challenge.Web.Client.Services
@using Microsoft.AspNetCore.Components.Forms;

@page "/"

<div class="container">
    <InputFile OnChange="Upload" multiple />
</div>

@code {
    [Inject] FileUploadClient _client { get; set; } = default!;

    private async Task Upload(InputFileChangeEventArgs args)
    {
        var fileTasks = args.GetMultipleFiles();
        await _client.Upload(fileTasks);
    }
}